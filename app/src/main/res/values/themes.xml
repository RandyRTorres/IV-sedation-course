<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.TextOverlayAssistant" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ios_blue</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:colorBackground">@color/ios_bg</item>
        <item name="colorSurface">@color/ios_bg</item>
        <item name="android:statusBarColor">@color/ios_nav</item>
        <item name="android:navigationBarColor">@color/ios_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Large bold "Messages" title, iOS-style -->
    <style name="NavTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/ios_primary_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>
</resources>
